pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Privacy Model ───────────────────────────────────────────────────────────
// PUBLIC (on-chain, visible to anyone):
//   - `count`: the running counter total.
//   - `owner`: a hash commitment identifying the current owner (not the secret).
//   - `initialized`: one-time-setup flag. Prevents init from running twice
//     (a `count == 0` guard alone would never trip, since init leaves count
//     at 0 — anyone could re-run init and steal ownership).
// PRIVATE (never leaves the user's machine, never rendered in the UI):
//   - `userSecret()`: witness returning the owner's 32-byte secret.
// PROVED without revealing:
//   - That the caller knows the secret behind `owner`.
// DISCLOSED deliberately (via disclose()):
//   - Only the owner commitment at init. The increment amount is the public
//     constant 1 — there is no step input to hide; the new total simply moves
//     by one on the public ledger.
//
// NOTE: Compact's privacy checker forbids writing a witness-derived value into
// public state without disclose(). Since the public total must move by the
// increment, the step is a constant by design — matching the dApp, which has
// no step input at all.

export ledger count: Uint<64>;
export ledger owner: Bytes<32>;
export ledger initialized: Boolean;

witness userSecret(): Bytes<32>;

// Domain-separated hash turning a secret into a public commitment.
// Knowing the preimage is proven in-circuit; the secret itself never leaves
// the prover.
circuit ownerOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "campus-counter:owner:v1"), sk]);
}

// One-time setup: bind the counter to the caller's secret commitment.
// The flag (not count, which stays 0 through init) is what makes this
// truly one-time — otherwise anyone could re-run init and take ownership.
export circuit init(): [] {
  assert(!initialized, "already initialized");
  const sk = userSecret();
  owner = disclose(ownerOf(sk));
  initialized = true;
}

// Owner-only increment: moves the public total by the constant 1. The proof
// shows knowledge of the owner secret without revealing it.
export circuit increment(): [] {
  assert(initialized, "not initialized");
  const sk = userSecret();
  assert(owner == ownerOf(sk), "not owner");
  count = (count + 1) as Uint<64>;
}
